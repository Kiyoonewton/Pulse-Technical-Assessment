{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node tests/support/require-tests.mjs \"tests/unit/**/*.test.ts\" && node --import ./tests/support/register.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:db:prepare": "node tests/support/prepare-test-db.mjs",
    "test:integration": "npm run test:db:prepare && node tests/support/require-tests.mjs \"tests/integration/**/*.test.ts\" && node --import ./tests/support/register.mjs --import ./tests/support/integration-env.mjs --test --test-concurrency=1 \"tests/integration/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cobe": "^2.0.1",
    "mapbox-gl": "^3.24.0",
    "next": "16.2.7",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
